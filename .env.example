# Averse backend — local development environment variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of explicit origins allowed to call the API.
# Add your machine's LAN IP so Expo Go on a physical device can reach the backend.
# Example: http://localhost:8081,http://192.168.1.42:8081
#
# For emulator-only development (Android emulator / iOS Simulator on the same
# machine) localhost:8081 is sufficient.
AVESE_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ── Retriever ─────────────────────────────────────────────────────────────────
# tfidf (default) or bm25
AVESE_EXPERIMENTAL_RETRIEVER=tfidf

# ── Question length ───────────────────────────────────────────────────────────
AVESE_MAX_QUESTION_CODEPOINTS=2000

# ── Demo mode (optional) ──────────────────────────────────────────────────────
# Set to true to enable POST /api/v1/demo/complaints (loopback only).
AVESE_DEMO_MODE=false
# AVESE_DEMO_RECIPIENT_PHONE=+260XXXXXXXXX
